<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RootNamespace>Lantoss.Android</RootNamespace><AssemblyName>hopo</AssemblyName>
    <ApplicationId>io.github.namishkashyap.hopo</ApplicationId>
    <ApplicationTitle>hopo</ApplicationTitle>
    <ApplicationDisplayVersion>2.7.4</ApplicationDisplayVersion><ApplicationVersion>12</ApplicationVersion>
    <Version>2.7.4</Version><Product>hopo</Product>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
    <!-- The shared code serialises with reflection-based System.Text.Json; trimming would strip what it needs. -->
    <PublishTrimmed>false</PublishTrimmed><AndroidLinkMode>None</AndroidLinkMode><RunAOTCompilation>false</RunAOTCompilation>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Marshal methods are generated into a native library that an incremental build can leave out of step with the app code; the app then closes on start
         (UnsatisfiedLinkError for AndroidApp.n_onCreate). Registering the methods at start-up is always consistent. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><NuGetAudit>true</NuGetAudit><NuGetAuditMode>all</NuGetAuditMode><NuGetAuditLevel>low</NuGetAuditLevel>
    <!-- Windows-only members of the shared code (Windows key store, registry plans) compile here but are never called. -->
    <NoWarn>$(NoWarn);CA1416;CA1422</NoWarn>
  </PropertyGroup>
  <!-- The shared transfer, pairing and sync code, without the phone page server (ASP.NET Core does not run on Android; PhonePageStub.cs stands in). -->
  <ItemGroup>
    <Compile Include="../Core/*.cs" Exclude="../Core/AssemblyInfo.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../Networking/*.cs" Exclude="../Networking/BrowserPortal.cs;../Networking/BrowserSpaces.cs" Link="Networking/%(Filename)%(Extension)" />
    <!-- The same screens as hopo on the PC, Mac and Linux: the shared Avalonia shell and pages. Only the desktop start-up files are left out. -->
    <Compile Include="../Desktop/*.cs" Exclude="../Desktop/App.cs;../Desktop/Program.cs" Link="Desktop/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../Desktop/Assets/lantoss-256.png" Link="Assets/lantoss-256.png" />
  </ItemGroup>
  <!-- Android's implicit usings (Android.App, Android.Widget) clash with Avalonia names in the shared screens; Android files add them themselves. -->
  <ItemGroup>
    <Using Remove="Android.App" />
    <Using Remove="Android.Widget" />
    <Using Remove="Android.OS.Bundle" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>
</Project>
